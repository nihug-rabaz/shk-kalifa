# Files NOT uploaded to Vercel. The web deploy is only the Next.js app
# (src/, public/, data/, scripts/) — the kiosk apps live in this repo but ship
# separately as a Windows package, and their build output is hundreds of MB.

# deps + local build output (Vercel builds from source)
node_modules
.next
out
build

# secrets — the real values live in the Vercel project's Environment Variables
.env
.env.local
.env*.local

# kiosk apps + build artifacts (not part of the website)
kiosk-native
electron-kiosk
kiosk
kiosk-manager
kiosk-setup

# reference clone of the old repo
source-repo

# local logs / editor junk
logs
*.log
.DS_Store
*.tsbuildinfo

# loose font files at the repo root (the board's fonts live in public/welcome*/fonts)
PloniMLv2AAA-Bold.otf
PloniMLv2AAA-Medium.otf
